{
  "name": "rxn-renderer",
  "version": "1.0.2",
  "description": "RXN file renderer",
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "cheminfo-build --entry src/index.js --root RXNRenderer",
    "eslint": "eslint src",
    "eslint-fix": "npm run eslint -- --fix",
    "prettier": "prettier --check src",
    "prettier-write": "prettier --write src",
    "test": "npm run test-only && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/rxn-renderer.git"
  },
  "keywords": [],
  "author": "Luc Patiny",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cheminfo/rxn-renderer/issues"
  },
  "homepage": "https://github.com/cheminfo/rxn-renderer#readme",
  "dependencies": {
    "rxn-parser": "^2.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "cheminfo-build": "^1.3.2",
    "eslint": "^9.39.2",
    "eslint-config-cheminfo": "^17.2.0",
    "openchemlib": "^9.22.0",
    "prettier": "^3.8.1",
    "vitest": "^4.1.4"
  }
}
